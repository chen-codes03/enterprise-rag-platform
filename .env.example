# ===== 应用配置 =====
APP_NAME="企业知识库RAG智能问答平台"
APP_ENV="dev"
APP_HOST="0.0.0.0"
APP_PORT=8000

# ===== 鉴权 =====
# 生产环境务必修改为强随机值；此处仅为示例占位
API_KEY="sk-rag-demo-key-change-me"

# ===== 模型层（统一模型调用层）=====
# provider 可选: deepseek | qwen
MODEL_PROVIDER="deepseek"

# DeepSeek (OpenAI 兼容)
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# 通义千问 (OpenAI 兼容 DashScope)
QWEN_API_KEY="your-qwen-api-key"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# ===== Embedding =====
EMBEDDING_PROVIDER="openai"
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_BASE_URL="https://api.deepseek.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# ===== RAG =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVE_TOP_K=4

# ===== 向量库 =====
CHROMA_PERSIST_DIR="data/chroma"
CHROMA_COLLECTION="enterprise_kb"

# ===== Redis 缓存 =====
REDIS_URL="redis://localhost:6379/0"
QA_CACHE_TTL=3600
EMBEDDING_CACHE_TTL=86400
